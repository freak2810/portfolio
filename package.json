{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "next dev",
    "typecheck": "next typegen && tsc --noEmit",
    "measure": "node scripts/measure.ts",
    "serve": "node scripts/serve-out.ts",
    "lighthouse": "node scripts/lighthouse-check.ts",
    "build": "node scripts/check-content.ts && node scripts/build-resume.ts && next build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pdfkit": "0.17.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lighthouse": "13.6.0",
    "pdfkit": "0.20.2",
    "typescript": "7.0.2"
  }
}
